# 对外端口（门店内网）。RELAY_ 前缀归 EdgeSettings。
RELAY_SITE_ID=shop-001
RELAY_HOST=0.0.0.0
RELAY_PORT=8020
RELAY_HEARTBEAT_TIMEOUT_SECONDS=90
RELAY_SWEEP_INTERVAL_SECONDS=15

# 管理端口（只绑回环）。ADMIN_ 前缀归 AdminSettings —— 同一份 .env，两个单元各读自己的前缀。
ADMIN_HOST=127.0.0.1
ADMIN_PORT=9020
# 留空则由 SecretStore 提供（见 relay/secrets.py）
ADMIN_TOKEN=

# SecretStore 读的文件；不存在时用确定性的开发口令。
SECRETS_FILE=secrets.json
