# 复制为 .env 后按需修改；不设置任何变量时，守护进程以「零外部依赖」模式运行
# （合成波形采集 + 内存存储 + 日志告警），适合本地开发与测试。

# --- 采集 -------------------------------------------------------------
# false = 确定性合成波形（默认）；true = 轮询 SOURCE_URL 上的 JSON 端点
USE_HTTP_SOURCE=false
SOURCE_URL=http://localhost:9100/metrics
SOURCE_TIMEOUT_SECONDS=5.0

COLLECT_INTERVAL_SECONDS=1.0
EVALUATE_INTERVAL_SECONDS=5.0

# --- 存储 -------------------------------------------------------------
# 每个 (设备, 指标) 保留的样本数——环形缓冲，内存占用有上界
SERIES_CAPACITY=600

# --- 规则 -------------------------------------------------------------
WINDOW_SECONDS=30.0
# 相对上一窗口的变化超过这个比例即告警（0.5 = 50%）
RATE_CHANGE_RATIO=0.5
OFFLINE_AFTER_SECONDS=30.0

# --- 告警 -------------------------------------------------------------
# false = 写日志（默认）；true = POST 到 ALERT_WEBHOOK_URL
USE_WEBHOOK_SINK=false
ALERT_WEBHOOK_URL=http://localhost:9200/alerts
ALERT_COOLDOWN_SECONDS=300.0
ALERT_HISTORY_SIZE=500
