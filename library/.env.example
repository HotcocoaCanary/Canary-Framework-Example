# 复制为 .env 后按需修改；不设置任何变量时，应用以「零外部依赖」模式启动
# （SQLite 内存库 + 离线确定性 embedding/chat），适合本地开发与测试。

# --- 服务 -------------------------------------------------------------
PORT=8010
# 宿主机上映射 postgres 的端口（本机 5432 被占用时改这里）
POSTGRES_PORT=5432

# --- 存储 -------------------------------------------------------------
# sqlite | postgres
STORAGE=sqlite
# storage=sqlite 时生效；":memory:" 表示进程内临时库
SQLITE_PATH=:memory:
SQL_ECHO=false

# storage=postgres 时生效（需要 pgvector 扩展，见 docker-compose.yml）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_BASE=localhost:5432
POSTGRES_DB=ly_library

# --- 模型 -------------------------------------------------------------
# local  = 离线确定性实现，不发网络请求（默认）
# openai = 任何 OpenAI 兼容端点：litellm / DashScope compatible-mode / vLLM
EMBEDDING_PROVIDER=local
CHAT_PROVIDER=local
EMBEDDING_DIM=1024

LLM_API_BASE=http://localhost:4100
LLM_API_KEY=sk-litellm
EMBEDDING_MODEL_NAME=text-embedding-v3
CHAT_MODEL_NAME=qwen-plus

# --- RAG --------------------------------------------------------------
CHUNK_SIZE=400
CHUNK_OVERLAP=80
RETRIEVE_TOP_K=5
MIN_SIMILARITY=0.05

# --- 图书馆业务规则 -----------------------------------------------------
LOAN_DAYS_DEFAULT=30
MAX_RENEWS=2
FINE_CENTS_PER_OVERDUE_DAY=50
MAX_FINE_CENTS_BEFORE_BLOCK=2000
RESERVATION_HOLD_HOURS=48
